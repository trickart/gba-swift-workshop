{
    "name": "gba-swift-workshop",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "swiftlang.swift-vscode"
            ],
            "settings": {
                "makefile.configureOnOpen": false
            }
        }
    },
    // 作成時に一度ビルドしておく (ツールチェーンの動作確認と、初回ビルドの待ち時間の先払い)
    "postCreateCommand": "make build"
}
